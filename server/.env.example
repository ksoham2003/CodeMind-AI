# Server
PORT=5000
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://localhost:27017/codemind

# Gemini
GEMINI_API_KEY=your_gemini_api_key_here

# Groq LLM
GROQ_API_KEY=your_groq_api_key_here

# Primary LLM model name used by the server. Replace with a model you have access to.
# Examples (provider-specific): gpt-4o-mini, gpt-4o, gpt-4
LLM_MODEL=gpt-4o-mini

# Optional fallback model(s) tried when the primary model returns model_not_found.
# You can set a single model name here. The server also tries a couple of sensible defaults.
LLM_FALLBACK_MODEL=gpt-4o

# Optional: use a cheaper model for interactive chat to reduce cost/token usage.
# Set this to a smaller model you have access to, e.g. a gpt-3.5-family model on your provider.
LLM_CHAT_MODEL=gpt-3.5-small

# Pinecone
# Create an index at pinecone.io with dimension=3072, metric=cosine (matches gemini-embedding-001)
PINECONE_API_KEY=...
PINECONE_INDEX_NAME=codemind

# GitHub (optional — increases rate limit for cloning public repos)
GITHUB_TOKEN=ghp_...

# Temp directory for cloned repos (relative to server root)
TEMP_DIR=temp

# Redis (for caching, rate-limiting, job queues)
REDIS_URL=redis://127.0.0.1:6379

# Background job queue concurrency
QUEUE_CONCURRENCY=2
