# Server
PORT=5000
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://localhost:27017/codemind

# Gemini
GEMINI_API_KEY=your_gemini_api_key_here

# Groq LLM
GROQ_API_KEY=your_groq_api_key_here

# Pinecone
# Create an index at pinecone.io with dimension=3072, metric=cosine (matches gemini-embedding-001)
PINECONE_API_KEY=...
PINECONE_INDEX_NAME=codemind

# GitHub (optional — increases rate limit for cloning public repos)
GITHUB_TOKEN=ghp_...

# Temp directory for cloned repos (relative to server root)
TEMP_DIR=temp
